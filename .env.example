# AI 漫剧平台环境变量配置
# 复制此文件为 .env 并根据实际情况修改

# ==================== 数据库配置 ====================
# 数据库连接 URL
DATABASE_URL=sqlite:///../workspace/platform.db

# ==================== 存储配置 ====================
# 项目文件存储根目录
STORAGE_ROOT=../workspace

# ==================== 平台本地配置 ====================
APP_HOST=127.0.0.1
APP_PORT=8012
APP_WORKSPACE=./workspace
APP_PROJECTS_DIR=./workspace/projects
APP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ==================== Worker 配置 ====================
TEXT_WORKERS=1
IMAGE_WORKERS=2
VIDEO_WORKERS=1

# ==================== FFmpeg 配置 ====================
# FFmpeg 可执行文件路径
# Windows 示例
FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# Linux/Mac 示例（通常在 PATH 中，可留空）
# FFMPEG_PATH=ffmpeg

# FFmpeg 线程池大小
FFMPEG_EXECUTOR_MAX_WORKERS=4

# ==================== 服务器配置 ====================
# 后端服务器主机（生产环境应使用 127.0.0.1）
BACKEND_HOST=127.0.0.1
# 后端服务器端口
BACKEND_PORT=8000

# 前端服务器主机
FRONTEND_HOST=127.0.0.1
# 前端服务器端口
FRONTEND_PORT=3000

# 运行环境（development | production）
ENV=development

# ==================== AI Provider API 密钥 ====================
# 推荐在接口配置页直接填写 API Key，平台会使用 Windows DPAPI 加密保存。
# 以下变量仅用于兼容旧 Provider 配置，可按需填写。

# OpenAI
# OPENAI_API_KEY=sk-...
# TEXT_API_KEY=
# IMAGE_API_KEY=
# VIDEO_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...

# 其他 Provider（根据需要添加）
# CUSTOM_PROVIDER_API_KEY=...

# ==================== 安全配置 ====================
# 加密密钥（用于加密存储的 API 密钥）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ENCRYPTION_KEY=

# ==================== 日志配置 ====================
# 日志级别（DEBUG | INFO | WARNING | ERROR）
LOG_LEVEL=INFO

# 日志文件路径
# LOG_FILE=backend.log

# ==================== 调试配置 ====================
# 启用调试模式（不要在生产环境启用）
DEBUG=false

# 启用详细日志
# VERBOSE=false

# ==================== 性能配置 ====================
# 数据库连接池大小
# DB_POOL_SIZE=5

# ==================== 数据库迁移配置 ====================
# 跳过数据删除（用于 20260806_0008 迁移）
# SKIP_DATA_DELETION=0

# ==================== 其他配置 ====================
# 时区
TZ=Asia/Shanghai
