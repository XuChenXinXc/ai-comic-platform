# AI 漫剧平台环境变量配置
# 复制此文件为 .env 并根据实际情况修改

# ==================== 配置说明 ====================
# 1. 配置优先级：
#    - APP_PROJECTS_DIR 初始值来自此文件，之后可在 Web UI "平台设置"页动态修改（无需重启）
#    - API Key 推荐在 Web UI "接口配置"页填写（Windows DPAPI 加密），环境变量仅作兼容
#
# 2. Worker 配置建议（根据 CPU 核心数选择）：
#    - CPU 4 核以下：TEXT_WORKERS=1, IMAGE_WORKERS=2, VIDEO_WORKERS=1
#    - CPU 8 核：TEXT_WORKERS=2, IMAGE_WORKERS=4, VIDEO_WORKERS=2
#    - CPU 16 核及以上：TEXT_WORKERS=4, IMAGE_WORKERS=8, VIDEO_WORKERS=4
#
# 3. Windows 路径限制：
#    - APP_PROJECTS_DIR 总长度需 < 137 个字符（中文占 1 个字符）
#    - 推荐：D:/Projects/AI（13 字符）
#    - 避免：C:/Users/用户名/Documents/AIComicProjects（可能超长）

# ==================== 平台配置 ====================
# 服务器监听地址
APP_HOST=127.0.0.1
# 服务器端口
APP_PORT=8012
# 调试模式（不要在生产环境启用）
APP_DEBUG=false

# ==================== 数据库配置 ====================
# 数据库连接 URL
# 留空使用默认值：workspace/platform.db
# APP_DATABASE_URL=sqlite:///./workspace/platform.db

# ==================== 存储配置 ====================
# 工作区目录（包含数据库和默认项目存储）
APP_WORKSPACE=./workspace

# 项目媒体存储根目录（可选）
# 留空使用默认值：workspace/projects
# 如需自定义，推荐在 Web UI 的"平台设置"页配置（支持热更新，无需重启）
# 注意：
#   1. 路径不能是磁盘根目录、平台源码目录或其上级目录
#   2. Windows 路径总长度需 < 137 个字符（中文占 1 个字符）
# Windows 示例（推荐短路径）：
#   APP_PROJECTS_DIR=D:/AIProjects              # 15 字符，推荐
#   APP_PROJECTS_DIR=E:/Comic                   # 8 字符，推荐
# Windows 示例（避免超长路径）：
#   # APP_PROJECTS_DIR=C:/Users/用户名/Documents/AIComicProjects  # 可能超过 137 字符
# Linux/Mac 示例：
#   APP_PROJECTS_DIR=/data/ai-comic-projects

# ==================== CORS 配置 ====================
# 跨域资源共享允许的来源
# 多个来源用逗号分隔，不支持通配符 *
# 开发环境需包含前端开发服务器地址
APP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ==================== Worker 配置 ====================
# 文字生成并发数（LLM 调用）
# 推荐值：CPU 4核=1, 8核=2, 16核+=4
TEXT_WORKERS=1

# 图像生成并发数
# 推荐值：CPU 4核=2, 8核=4, 16核+=8
IMAGE_WORKERS=2

# 视频生成并发数
# 推荐值：CPU 4核=1, 8核=2, 16核+=4
VIDEO_WORKERS=1

# ==================== AI Provider API 密钥（可选）====================
# 推荐方式：在 Web UI 的"接口配置"页填写 API Key
# 平台会使用系统密钥库加密保存（Windows DPAPI / macOS Keychain），重启后仍可用
#
# 以下环境变量仅用于兼容旧 Provider 的 api_key_env 配置：
# 在创建 Provider 时，如果 api_key_env 字段填写了以下变量名，
# 平台会从环境变量读取密钥（不推荐，因为需要重启才能生效）
#
# 文字生成 API Key
# TEXT_API_KEY=sk-...
#
# 图像生成 API Key
# IMAGE_API_KEY=sk-...
#
# 视频生成 API Key
# VIDEO_API_KEY=sk-...
#
# ImgBB Key 已迁到「平台设置 → ImgBB Key」页面加密保存（DPAPI/Keychain），
# 不再从此 .env 读取。设置页面提供「保存」与「清除」两个动作。
# 历史 .env 中遗留的 APP_IMGBB_API_KEY 仍可作为兜底，但建议清理。
#
# OpenAI 兼容接口
# OPENAI_API_KEY=sk-...
#
# 其他自定义 Provider（根据 api_key_env 配置添加）
# CUSTOM_PROVIDER_API_KEY=...

# ==================== FFmpeg 配置（可选）====================
# FFmpeg 和 ffprobe 可执行文件路径
# 默认从系统 PATH 查找，通常无需配置
# Windows 示例（如果未加入 PATH）：
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
